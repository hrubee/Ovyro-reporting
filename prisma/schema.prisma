// ─── ORETA WORLD HYGIENE & CLEANING SOP ───────────────────────────────────────
model OretaHygieneEntry {
  id               String   @id @default(cuid())
  date             String
  day              String
  submittedById    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

