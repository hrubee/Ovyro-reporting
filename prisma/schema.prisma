generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("database_DATABASE_URL")
}

// Role: "ADMIN" | "EMPLOYEE"
// Sheet: "HYGIENE_REPORT" | "GLASS_REPORT" | "FRIDGE_REPORT" | "KITCHEN" | "PRODUCTION" | "PUFF_ROOM" | "CAKE_ROOM"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EMPLOYEE")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sheetAccess       SheetAccess[]
  hygieneEntries    HygieneEntry[]
  glassEntries      GlassEntry[]
  fridgeEntries     FridgeEntry[]
  kitchenEntries    KitchenEntry[]
  productionEntries ProductionEntry[]
  puffRoomEntries   PuffRoomEntry[]
  cakeRoomEntries   CakeRoomEntry[]
  oretaHygieneEntries OretaHygieneEntry[]
}

model SheetAccess {
  id        String   @id @default(cuid())
  userId    String
  sheet     String
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sheet])
}

// ─── HYGIENE REPORT ───────────────────────────────────────────────────────────
model HygieneEntry {
  id            String   @id @default(cuid())
  date          String
  day           String
  submittedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  areaChecks       String
  supervisorName   String @default("")
  comments         String @default("")
  correctiveAction String @default("")

  submittedBy User @relation(fields: [submittedById], references: [id])

  @@index([date])
}

